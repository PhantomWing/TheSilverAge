{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_homepage}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.phantomwing.thesilverage.fabric.TheSilverAgeFabric"
    ],
    "client": [
      "com.phantomwing.thesilverage.fabric.client.TheSilverAgeFabricClient"
    ]
  },
  "mixins": [
    "thesilverage.mixins.json"
  ],
  "accessWidener": "thesilverage.accesswidener",
  "depends": {
    "fabricloader": "${dep_fabricloader}",
    "fabric-api": "${dep_fabric_api}",
    "minecraft": "${dep_minecraft_fabric}",
    "architectury": "${dep_architectury_fabric}",
    "cloth-config": "${dep_cloth}"
  }
}
