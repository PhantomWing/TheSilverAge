accessWidener	v2	named

# Silver door/trapdoor/pressure-plate behaviour needs the BlockSetType to be
# registered in the vanilla static registry (ModBlockSetTypes). BlockSetType.register
# is private in vanilla; the old NeoForge build relied on this being public.
accessible	method	net/minecraft/world/level/block/state/properties/BlockSetType	register	(Lnet/minecraft/world/level/block/state/properties/BlockSetType;)Lnet/minecraft/world/level/block/state/properties/BlockSetType;

# Moon Dial `moon_phase` item-property override (client). ItemProperties.register
# is private in vanilla Mojmap; NeoForge's patched jar exposes it (the original
# single-loader NeoForge build called it directly), so widen it here for the
# shared common client.ModItemProperties. This is the only entry the common
# client item-property registration needs and keeps the registered id/predicate
# byte-identical across both loaders.
accessible	method	net/minecraft/client/renderer/item/ItemProperties	register	(Lnet/minecraft/world/item/Item;Lnet/minecraft/resources/ResourceLocation;Lnet/minecraft/client/renderer/item/ClampedItemPropertyFunction;)V

# Silver Nugget firework-star parity (common ModFireworks). Vanilla
# FireworkStarRecipe keeps SHAPE_BY_ITEM (item -> shape) and SHAPE_INGREDIENT
# (== keySet) as private static final; the loader-agnostic patch reads and
# reassigns both, so widen them accessible + mutable. NeoForge production
# mirrors these with `public-f` entries in accesstransformer.cfg (the AW is not
# converted to an AT in remapJar).
accessible	field	net/minecraft/world/item/crafting/FireworkStarRecipe	SHAPE_BY_ITEM	Ljava/util/Map;
mutable	field	net/minecraft/world/item/crafting/FireworkStarRecipe	SHAPE_BY_ITEM	Ljava/util/Map;
accessible	field	net/minecraft/world/item/crafting/FireworkStarRecipe	SHAPE_INGREDIENT	Lnet/minecraft/world/item/crafting/Ingredient;
mutable	field	net/minecraft/world/item/crafting/FireworkStarRecipe	SHAPE_INGREDIENT	Lnet/minecraft/world/item/crafting/Ingredient;
