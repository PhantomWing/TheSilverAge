# Silver door/trapdoor/pressure-plate behaviour needs the BlockSetType to be
# registered in the vanilla static registry (ModBlockSetTypes). BlockSetType.register
# is private in vanilla; the old NeoForge build relied on this being public.
accessible	method	net/minecraft/world/level/block/state/properties/BlockSetType	register	(Lnet/minecraft/world/level/block/state/properties/BlockSetType;)Lnet/minecraft/world/level/block/state/properties/BlockSetType;

# Moon Dial `moon_phase` (client). 1.21.4 removed ItemProperties.register and the
# whole item-`overrides` system, replacing it with data-driven item model
# definitions. Custom range-select properties are registered into the vanilla
# (private) RangeSelectItemModelProperties.ID_MAPPER late-bound mapper; widen it
# so the shared common client.ModItemProperties can `.put(thesilverage:moon_phase,
# codec)` on both loaders. Mirrored by a `public` field entry in the NeoForge AT.
accessible	field	net/minecraft/client/renderer/item/properties/numeric/RangeSelectItemModelProperties	ID_MAPPER	Lnet/minecraft/util/ExtraCodecs$LateBoundIdMapper;

# The Moon Dial's moon tint (client.ModItemColors): from 1.21.4 an item's tint is a tint source named in its items/
# definition, and a mod's tint source type goes into vanilla's (private) ItemTintSources.ID_MAPPER. Mirrored in
# NeoForge's accesstransformer.cfg, where RegisterColorHandlersEvent.ItemTintSources registers it too.
accessible	field	net/minecraft/client/color/item/ItemTintSources	ID_MAPPER	Lnet/minecraft/util/ExtraCodecs$LateBoundIdMapper;

# Silver Nugget firework-star parity (common ModFireworks). Vanilla
# FireworkStarRecipe keeps SHAPE_BY_ITEM (item -> shape) as private static final;
# the loader-agnostic patch reads and reassigns it, so widen it accessible +
# mutable. NeoForge production mirrors this with a `public-f` entry in
# accesstransformer.cfg (the AW is not converted to an AT in remapJar).
# (1.21.2 removed the cached SHAPE_INGREDIENT field — matches() reads the map.)
accessible	field	net/minecraft/world/item/crafting/FireworkStarRecipe	SHAPE_BY_ITEM	Ljava/util/Map;
mutable	field	net/minecraft/world/item/crafting/FireworkStarRecipe	SHAPE_BY_ITEM	Ljava/util/Map;

