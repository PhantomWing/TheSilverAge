{
  "name": "Mod Menu opens the Fabric config screen with every option named, its tooltips, and no option ids as text boxes",
  "loader": "fabric",
  "steps": [
    { "config": true },
    { "expect": "screen", "title": "The Silver Age Configuration" },
    { "expect": "widget", "label": "Silverfish drop Silver Nuggets" },
    { "expect": "widget", "label": "text.autoconfig.", "exists": false },
    { "hover": [213, 12] },
    { "screenshot": "options" },
    { "hover": "Silverfish drop Silver Nuggets" },
    { "expect": "tooltip", "line": "Should Silverfish randomly drop 0-2 Silver Nuggets?" },
    { "hover": "Override vanilla recipes" },
    { "expect": "tooltip", "has": "Tweaks some existing crafting recipes to use Silver instead." },
    { "scroll": -5 },
    { "expect": "widget", "label": "Glistering Melon recipe" },
    { "expect": "widget", "label": "text.autoconfig.", "exists": false },
    { "hover": "Generate silver ore" },
    { "expect": "tooltip", "has": "Should silver ore generate in new chunks?" },
    { "scroll": -20 },
    { "expect": "widget", "label": "Silver floor damage" },
    { "expect": "widget", "label": "text.autoconfig.", "exists": false },
    { "hover": "Undead protection" },
    { "expect": "tooltip", "line": "Should silver armor reduce damage taken from undead mobs?" },
    { "expect": "widget", "label": "Save & Quit", "active": false },
    { "click": "Silver floor damage" },
    { "expect": "widget", "label": "Save & Quit", "active": true },
    { "click": "Silver floor damage" },
    { "expect": "widget", "label": "Save & Quit", "active": false },
    { "screenshot": "last-options" },
    { "close": true },
    { "expect": "screen", "open": false }
  ]
}
